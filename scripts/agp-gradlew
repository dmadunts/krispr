#!/usr/bin/env bash
# Runs Gradle with -Pkrispr.agp=<version>, at a Gradle version that AGP can run on, so sample-android
# builds against that AGP:
#
#   (cd sample-android && ../scripts/agp-gradlew 8.13.2 :lib:krisprRun)
#
# AGP 9 runs on the repository's wrapper. AGP 8 cannot run on Gradle 9.6 or newer (it uses an internal
# Gradle API that 9.6 removed), so it gets Gradle 8.14.3 through a wrapper kept in build/agp-gradlew.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ $# -lt 1 || ! "$1" =~ ^[0-9]+\.[0-9]+ ]]; then
    echo "usage: $0 <agp-version> [gradle arguments...]" >&2
    exit 2
fi
agp="$1"
shift

case "$agp" in
    8.*) gradle="8.14.3" ;;
    *) exec "$root/gradlew" "-Pkrispr.agp=$agp" "$@" ;;
esac

# The wrapper reads gradle-wrapper.properties from next to its jar.
wrapper="$root/build/agp-gradlew/gradle-$gradle"
mkdir -p "$wrapper"
cp "$root/gradle/wrapper/gradle-wrapper.jar" "$wrapper/"
sed -E "s#gradle-[0-9.]+-(bin|all)\.zip#gradle-$gradle-bin.zip#" "$root/gradle/wrapper/gradle-wrapper.properties" > "$wrapper/gradle-wrapper.properties"
java="java"
[[ -n "${JAVA_HOME:-}" ]] && java="$JAVA_HOME/bin/java"
exec "$java" -Dorg.gradle.appname=agp-gradlew -classpath "$wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain "-Pkrispr.agp=$agp" "$@"
